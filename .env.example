# Copy this file to ".env" and fill in real values there.
# Never commit the real ".env" file — it's already excluded via .gitignore.

SUPABASE_URL=your-project-url-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-service-role-key-here
GROQ_API_KEY=your-groq-api-key-here

# Shared secret the scheduled demo-cleanup job sends as a Bearer token to
# POST /demo/cleanup. Generate any long random string — it just has to match
# between this value and the DEMO_CLEANUP_SECRET GitHub Actions secret.
DEMO_CLEANUP_SECRET=your-own-random-secret-here
